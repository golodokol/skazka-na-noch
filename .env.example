# Telegram
TELEGRAM_BOT_TOKEN=123456:ABC-DEF...
# Если VPN только для браузера — укажите системный прокси (пример):
# TELEGRAM_PROXY=socks5://127.0.0.1:1080

# Webhook (production)
WEBHOOK_URL=https://your-domain.com/webhook
WEBHOOK_SECRET=random_secret_string

# LLM (choose one)
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4.1-mini
# Модели по этапам (фаза 5; по умолчанию = OPENAI_MODEL)
# OPENAI_MODEL_DRAFT=gpt-4.1-mini
# OPENAI_MODEL_POLISH=gpt-4.1-mini
# OPENAI_MODEL_MEDIUM=gpt-4.1
# Rewrite-pass: полировка прозы вторым вызовом LLM (только если черновик не прошёл проверки)
ENABLE_REWRITE_PASS=1
# 1 = polish и для tired/screen_free
# ENABLE_REWRITE_PASS_ALL=0
# Сколько раз перегенерировать черновик при нарушениях (по умолчанию 1)
# MAX_DRAFT_RETRIES=1
# Через сколько секунд показать «ещё пишу…» в Telegram (по умолчанию 30)
# GENERATION_STATUS_WAIT_SEC=30
# A/B: нечётный user_id — без polish (сравнение качества)
# AB_TEST_ENABLED=0
# Температура draft по режимам (опционально)
# TEMP_TIRED=0.70
# TEMP_TODAY=0.70
# TEMP_MEDIUM=0.75
# POLISH_TEMPERATURE=0.50

# Промпт v2 (фазы 1–6). v1 — откат на старую сборку (если понадобится)
PROMPT_VERSION=v2
# ANTHROPIC_API_KEY=
# GIGACHAT_CREDENTIALS=

# Database
DATABASE_URL=sqlite:///./data/bot.db
# DATABASE_URL=postgresql://user:pass@host:5432/skazka

# TTS (P1, optional)
# OPENAI_TTS_VOICE=nova
# YANDEX_API_KEY=

# App
ENV=development
LOG_LEVEL=INFO

# Analytics (optional)
# POSTHOG_API_KEY=
