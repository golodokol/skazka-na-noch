# Telegram
TELEGRAM_BOT_TOKEN=123456:ABC-DEF...

# Webhook (production)
WEBHOOK_URL=https://your-domain.com/webhook
WEBHOOK_SECRET=random_secret_string

# LLM (choose one)
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4.1-mini
# ANTHROPIC_API_KEY=
# GIGACHAT_CREDENTIALS=

# Database
DATABASE_URL=sqlite:///./data/bot.db
# DATABASE_URL=postgresql://user:pass@host:5432/skazka

# TTS (P1, optional)
# OPENAI_TTS_VOICE=nova
# YANDEX_API_KEY=

# Payments (P1, optional)
# TELEGRAM_PAYMENT_PROVIDER_TOKEN=
# PRODAMUS_SECRET=

# App
ENV=development
LOG_LEVEL=INFO
FREE_STORIES_PER_WEEK=5
SUBSCRIPTION_PRICE_RUB=399

# Analytics (optional)
# POSTHOG_API_KEY=
