# Telegram
TELEGRAM_BOT_TOKEN=123456:ABC-DEF...
# Если VPN только для браузера — укажите системный прокси (пример):
# TELEGRAM_PROXY=socks5://127.0.0.1:1080

# Webhook (production)
WEBHOOK_URL=https://your-domain.com/webhook
WEBHOOK_SECRET=random_secret_string

# LLM (choose one)
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4.1-mini
# ANTHROPIC_API_KEY=
# GIGACHAT_CREDENTIALS=

# Database
DATABASE_URL=sqlite:///./data/bot.db
# DATABASE_URL=postgresql://user:pass@host:5432/skazka

# TTS (P1, optional)
# OPENAI_TTS_VOICE=nova
# YANDEX_API_KEY=

# App
ENV=development
LOG_LEVEL=INFO

# Analytics (optional)
# POSTHOG_API_KEY=
